{
  "name": "plasticwan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "plasticwan": "./src/cli.ts"
  },
  "scripts": {
    "check": "tsc --noEmit && pnpm run cli:check && pnpm --filter plasticwan-admin-next run check && pnpm run docs:check",
    "cli:check": "tsc -p packages/cli/tsconfig.json --noEmit",
    "cli:build": "tsc -p packages/cli/tsconfig.json",
    "test": "vitest run",
    "start": "node src/cli.ts serve",
    "admin:dev": "pnpm --filter plasticwan-admin-next run dev",
    "admin:build": "pnpm --filter plasticwan-admin-next run build",
    "admin:test:e2e": "pnpm --filter plasticwan-admin-next run test:e2e",
    "docs:dev": "pnpm --filter plasticwan-docs run dev",
    "docs:build": "pnpm --filter plasticwan-docs run build",
    "docs:preview": "pnpm --filter plasticwan-docs run preview",
    "docs:check": "pnpm --filter plasticwan-docs run check",
    "docs:verify": "node scripts/docs-verify.ts",
    "lint": "biome lint . && biome format .",
    "lint:fix": "biome lint --write --unsafe . && biome format --write ."
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@hono/node-server": "^2.1.1",
    "@inquirer/prompts": "^8.6.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@node-rs/argon2": "^2.2.1",
    "@plasticwan/image-service": "workspace:^",
    "@simplewebauthn/server": "14.0.3",
    "better-sqlite3": "^13.0.3",
    "defuddle": "0.19.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "grammy": "1.45.1",
    "hono": "^4.13.8",
    "jsonc-parser": "^3.3.1",
    "sharp": "0.35.3",
    "typebox": "1.3.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.5",
    "typescript": "5.9.3",
    "vitest": "^5.0.1",
    "zod": "4.4.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
